<script>
// === LANGUAGE SWITCHER ===
(function() {
  const savedLang = localStorage.getItem('hf_lang') || 'it';
  setLang(savedLang);
})();

function setLang(lang) {
  localStorage.setItem('hf_lang', lang);
  document.querySelectorAll('.lang-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.lang === lang);
  });
  document.querySelectorAll('[data-it]').forEach(el => {
    const text = el.getAttribute('data-' + lang);
    if (text !== null) el.textContent = text;
  });
  document.querySelectorAll('[data-ph-it]').forEach(el => {
    const ph = el.getAttribute('data-ph-' + lang);
    if (ph !== null) el.placeholder = ph;
  });
}

// === CAROUSEL ===
document.querySelectorAll('.carousel-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const carousel = btn.parentElement.querySelector('.carousel');
    const scrollAmount = 220;
    carousel.scrollBy({ left: btn.classList.contains('prev') ? -scrollAmount : scrollAmount, behavior: 'smooth' });
  });
});

// === CATEGORY CARDS ===
document.querySelectorAll('.cat-card').forEach(card => {
  card.addEventListener('click', () => {
    const targetId = card.dataset.target;
    const wasActive = card.classList.contains('active');

    // Deselect all
    document.querySelectorAll('.cat-card').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.cat-group').forEach(g => g.classList.remove('visible'));

    if (wasActive) {
      // Show all
      document.querySelectorAll('.cat-group').forEach(g => g.classList.add('visible'));
    } else {
      // Show only selected
      card.classList.add('active');
      const target = document.getElementById(targetId);
      if (target) {
        target.classList.add('visible');
        // Auto-expand
        const header = target.querySelector('.cat-group-header');
        const body = target.querySelector('.cat-group-body');
        if (header && body) {
          header.classList.add('open');
          body.classList.add('open');
        }
        setTimeout(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
      }
    }
  });
});

// === COLLAPSIBLE ===
document.querySelectorAll('.cat-group-header').forEach(header => {
  header.addEventListener('click', () => {
    header.classList.toggle('open');
    header.nextElementSibling.classList.toggle('open');
  });
});
document.querySelectorAll('.cat-family-header').forEach(header => {
  header.addEventListener('click', () => {
    header.classList.toggle('open');
    header.nextElementSibling.classList.toggle('open');
  });
});

// === SEARCH & FILTERS ===
let searchTimer;
const searchInput = document.getElementById('searchInput');
const brandSelect = document.getElementById('brandSelect');
const offerToggle = document.getElementById('offerToggle');
const noResults = document.getElementById('noResults');

function applyFilters() {
  const term = (searchInput ? searchInput.value : '').toLowerCase().trim();
  const brand = brandSelect ? brandSelect.value : '';
  const offersOnly = offerToggle ? offerToggle.classList.contains('active') : false;
  let totalVisible = 0;

  // When filtering, show all groups and expand matches
  const isFiltering = term || brand || offersOnly;
  if (isFiltering) {
    document.querySelectorAll('.cat-card').forEach(c => c.classList.remove('active'));
  }

  document.querySelectorAll('.cat-group').forEach(group => {
    let groupVisible = 0;
    group.querySelectorAll('.cat-family').forEach(family => {
      let familyVisible = 0;
      family.querySelectorAll('.product-table tbody tr').forEach(row => {
        const searchData = row.getAttribute('data-search') || '';
        const rowBrand = row.getAttribute('data-brand') || '';
        const isOffer = row.getAttribute('data-offer') === '1';
        let show = true;
        if (term && !searchData.includes(term)) show = false;
        if (brand && rowBrand !== brand) show = false;
        if (offersOnly && !isOffer) show = false;
        row.style.display = show ? '' : 'none';
        if (show) familyVisible++;
      });
      family.style.display = familyVisible > 0 ? '' : 'none';
      if (familyVisible > 0) groupVisible += familyVisible;
      if (isFiltering && familyVisible > 0) {
        family.querySelector('.cat-family-header').classList.add('open');
        family.querySelector('.cat-family-body').classList.add('open');
      }
    });
    if (isFiltering) {
      group.classList.toggle('visible', groupVisible > 0);
      group.style.display = '';
      if (groupVisible > 0) {
        group.querySelector('.cat-group-header').classList.add('open');
        group.querySelector('.cat-group-body').classList.add('open');
      }
    }
    totalVisible += groupVisible;
  });

  if (!isFiltering) {
    // Restore: show all groups
    document.querySelectorAll('.cat-group').forEach(g => g.classList.add('visible'));
  }

  if (noResults) noResults.style.display = totalVisible === 0 && isFiltering ? 'block' : 'none';
}

if (searchInput) {
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(applyFilters, 200);
  });
}
if (brandSelect) brandSelect.addEventListener('change', applyFilters);
if (offerToggle) {
  offerToggle.addEventListener('click', () => {
    offerToggle.classList.toggle('active');
    applyFilters();
  });
}

// === SEE ALL OFFERS ===
function showAllOffers() {
  // Activate offer toggle and trigger filter
  if (offerToggle && !offerToggle.classList.contains('active')) {
    offerToggle.classList.add('active');
    applyFilters();
  }
  document.getElementById('catalogSection').scrollIntoView({ behavior: 'smooth' });
}

// === LIGHTBOX ===
function openLightbox(src) {
  document.getElementById('lightbox-img').src = src;
  document.getElementById('lightbox').classList.add('active');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('active');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });

// === BACK TO TOP ===
const btt = document.querySelector('.back-to-top');
if (btt) window.addEventListener('scroll', () => btt.classList.toggle('visible', window.scrollY > 400));
</script>

